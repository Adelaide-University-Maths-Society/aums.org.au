---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { styles } from "../styles/tailwindStyle";
import Card from "../components/Card.astro";
---

<BaseLayout pageTitle="Committee">
	<Navbar pageTitle="Committee" />
	<div class=`px-8 md:px-16 py-8 pb-16 flex flex-col items-center gap-[2vw]`>
		<h1 class=`font-heading text-primary font-black ${styles.xl3Text}`>
			AUMS Team 2026
		</h1>
		<div
			class="grid grid-cols-1 lg:grid-cols-2 gap-[2vw] w-full justify-center"
		>
			<Card
				name="Makon Westdorp"
				role="President"
				description="I’m Makon, a third year in Mathematical Sciences (Advanced)! I’m very excited to have the honour of being the 2026 president. This is my second time as a committee member, and I look forward to filling this role the best I can. If you ever see me around campus, feel free to stop by and ask any questions you have, about me, AUMS, or anything else! I have other interests in Board Games, and competitive Sailing!"
				imagePath="/src/assets/committee-images/makon-westdorp.png"
			/>
			<Card
				name="Anders Yu"
				role="Vide President"
				description="3nd Year Mathematical Sciences (Advanced) Student. Hi, I'm Anders, and I love doing pure maths because abstract mathematical concepts are always clearly defined even when real life is messy and chaotic 😆. Anyway, looking forward to see you all at AUMS events where we can yap about various nerdy things (including maths hopefully)."
				imagePath="/src/assets/committee-images/anders-yu.webp"
			/>
			<Card
				name="Vaughan Stonestreet"
				role="Treasurer"
				description="Hi, I'm Vaughan and I'm excited to be continuing in my role as Treasurer for AUMS in 2026! I like problem solving, learning about finance and money, and thinking deeply about interesting questions or issues that arise in my life. My main extra-curricular activity is swing dancing, which has given me access to such a great community of people and events! I also enjoy reading, watching movies, listening to music, and eating great food. I look forward to helping make 2026 a great year for AUMS!"
				imagePath="/src/assets/committee-images/vaughan-stonestreet.webp"
			/>
			<Card
				name="Toby Mak"
				role="Secretary"
				description="Hey there, I'm Toby and I'm a sociology and gender studies student in my (too long to be at uni) year! When I'm not busy secretarying for AUMS, I enjoy playing chess and going on long walks on the coast. I hope to see all your friendly faces around at our numerous events and hopefully we can enjoy dunking on the new Adelaide Uni together 😉"
				imagePath="/src/assets/committee-images/toby-mak.webp"
			/>
			<Card
				name="Lachlan Jenke"
				role="Technomancer"
				description="Hi! I'm Lachlan, a third year student studying a Bachelor of Software Engineering (Honours), though I began in Mathematical Sciences! I'm honoured and beyond excited to be this years technomancer for AUMS. Outside of Uni I love to read as much as I can, play a good board game and enjoy a swim. I look forward to meeting more like minded people!"
				imagePath="/src/assets/committee-images/lachlan-jenke.jpg"
			/>
			<Card
				name="Faith Sawers"
				role="Social Media Manager"
				description="2nd Year Master of Philosophy Student. Hello! My name is Faith and I am a second year MPhil candidate with a research focus in mathematical biology. I love talking about maths, books, and adventures. This is my 4th year on the committee in AUMS and I love it! As the social media manager, I try to make our  online presence interesting and engaging. Hopefully see you at an AUMS event soon!"
				imagePath="/src/assets/committee-images/faith-sawers.jpeg"
			/>
			<Card
				name="Toshiki Nakamoto"
				role="2nd Year Representative"
				description="Hello, I am Toshiki from Japan, and I will be the Second Year Representative this year in AUMS!! I am very excited to be involved in AUMS and to meet with other students through our events. I have a very strong interest in maths and analytical thinking."
				imagePath="/src/assets/committee-images/toshiki-nakamoto.webp"
			/>
			<Card
				name="Ellie Saises"
				role="General Committee Member"
				description="My name is Ellie and I absolutely love maths! When I’m not doing maths, I love speaking french, running and swimming, taking care of animals, spending time with friends and family and working ALOT (which I love less but must be done!) I hope to either pursue a masters in actuarial science or in mathematics, and hope to go back to France for a university exchange next year! There is so much to look forward to in the world of maths and I can’t wait to be a part of that!!"
				imagePath="/src/assets/committee-images/ellie-saies.jpeg"
			/>
			<Card
				name="Xuan Zhu"
				role="General Committee Member"
				description=" Hi everyone, I'm Xuan! I'm a former BMaC student currently wrapping up my final year in Mathematical Sciences.\n While I love the theory side of things, I've always viewed math primarily as a tool for creation. Outside of my degree, I'm usually busy creating or learning something new. Lately, I've been obsessed with AI research and integration — everything from building Discord bots with local LLMs and Stable Diffusion to keeping up with the latest papers.\n Anyways, looking forward to seeing you all at AUMS events! I'm always down to chat about tech, research, or... life in general. After all, the real math is the existential crisis we share in the library at 3:00 AM."
				imagePath="/src/assets/committee-images/xuan-zhu.webp"
			/>
			<!-- <Card
				name="Sam Feng"
				role="General Committee Member"
				description=""
				imagePath="/src/assets/committee-images/sam-feng.jpg"
			/> -->
		</div>
	</div>
	<Footer />
</BaseLayout>
