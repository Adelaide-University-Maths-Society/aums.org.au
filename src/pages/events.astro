---
import Navbar from "../components/Navbar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { styles } from "../styles/tailwindStyle";
import Hexagon from "../components/Hexagon";
import EventImage from "../components/EventImage.astro";
import EventCard from "../components/EventCard.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout pageTitle="Events">
    <Navbar pageTitle="Events" />
    <div class=`min-h-screen`>
        <div class=`${styles.mainPadding}`>
            <div class="flex flex-col md:flex-row justify-between items-center">
                <h1
                    class=`text-primary font-heading text-3xl lg:text-4xl font-black`
                >
                    2025 Events
                </h1>
                <a
                    href="/past-events"
                    class="hover:-translate-y-1 ease-in-out duration-100 delay-50 text-accent font-semibold text-xl flex items-center gap-2 deoreations-accent"
                >
                    See past events <Icon name="bi:arrow-90deg-left" />
                </a>
            </div>
            <div class="flex flex-col gap-4 pt-6">
                <EventCard
                    title="O-Week Stall"
                    description=""
                    dateTime="Wednesday 26th Feb"
                    color="bg-primary"
                />
                <EventCard
                    title="Meet & Greet"
                    description=""
                    dateTime="Thursday 6th Mar"
                    color="bg-primary"
                />
                <EventCard
                    title="AUMS x Citadel Securities Lunch"
                    description=""
                    dateTime="Thursday 13rd Mar"
                    color="bg-primary"
                />
                <EventCard
                    title="Pi Day"
                    description=""
                    dateTime="Friday 14th Mar"
                    color="bg-primary"
                />
                <EventCard
                    title="SGM"
                    description=""
                    dateTime="Thursday 20th Mar"
                    color="bg-primary"
                />
                <EventCard
                    title="AUMS x IMC Maths Relay"
                    description=""
                    dateTime="Thursday 3rd Apr"
                    color="bg-primary"
                />
                <EventCard
                    title="AUMS x CS Club Latex Workshop"
                    description=""
                    dateTime="Thursday 10th Apr"
                    color="bg-primary"
                />
                <EventCard
                    title="Pub Crawl"
                    description=""
                    dateTime="Friday 9th May"
                    color="bg-primary"
                />
                <EventCard
                    title="AUMS x WiSTEMS Womens in Maths Day"
                    description=""
                    dateTime="Monday 12th May"
                    color="bg-primary"
                />
                <EventCard
                    title="AUMS x SQUAD Poker Night"
                    description=""
                    dateTime="Thursday 22nd May"
                    color="bg-primary"
                />
            </div>
            <div class="font-body text-text pt-8 pb-8">
                Stay tuned for <span class="text-accent font-semibold"
                    >future events</span
                > as our event sequence is as dynamic as a mathematical function,
                always striving for optimization and the perfect solution to meet
                your requirements!
            </div>
        </div>
    </div>
    <Footer />
</BaseLayout>
