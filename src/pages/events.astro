---
import Navbar from "../components/Navbar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import { styles } from "../styles/tailwindStyle";
import Hexagon from "../components/Hexagon";
import EventImage from "../components/EventImage.astro";
import EventCard from "../components/EventCard.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout pageTitle="Events">
    <Navbar pageTitle="Events" />
    <div class=`min-h-screen`>
        <div class=`${styles.mainPadding}`>
            <!-- Upcoming Events Section -->
            <div class="flex flex-col md:flex-row justify-between items-center">
                <h1
                    class=`text-primary font-heading text-3xl lg:text-4xl font-black`
                >
                    Upcoming Events
                </h1>
            </div>
            <div class="flex flex-col gap-4 pt-6 pb-8">
                <EventCard
                    title="Special General Meeting"
                    description=""
                    dateTime="Thursday 16th April"
                    color="bg-primary"
                />
                <EventCard
                    title="Women in Math Day"
                    description=""
                    dateTime="Tuesday 12th May"
                    color="bg-primary"
                />
                <EventCard
                    title="Integration by Pints Pubcrawl"
                    description=""
                    dateTime="Friday 22nd May"
                    color="bg-primary"
                />
            </div>

            <!-- Past Events of the Year Section -->
            <div class="pt-8">
                <div class="flex flex-col md:flex-row justify-between items-center">
                    <h1
                        class=`text-primary font-heading text-3xl lg:text-4xl font-black`
                    >
                        Past Events of 2026
                    </h1>
                    <a
                        href="/past-events"
                        class="hover:-translate-y-1 ease-in-out duration-100 delay-50 text-accent font-semibold text-xl flex items-center gap-2 deoreations-accent"
                    >
                        See all past events <Icon name="bi:arrow-90deg-left" />
                    </a>
                </div>
                <div class="flex flex-col gap-4 pt-6">
                <EventCard
                    title="Clubsland Stall"
                    description=""
                    dateTime="Wednesday 25th Feb"
                    color="bg-primary"
                />
                <EventCard
                    title="Meet & Eat & Greet"
                    description=""
                    dateTime="Thursday 5th Mar"
                    color="bg-primary"
                />
                <EventCard
                    title="Industry Night"
                    description=""
                    dateTime="Tuesday 10th Mar"
                    color="bg-primary"
                />
                <EventCard
                    title="Pi Day"
                    description=""
                    dateTime="Friday 13th Mar"
                    color="bg-primary"
                />
                <EventCard
                    title="Movie Night with Film Club"
                    description=""
                    dateTime="Friday 3rd April"
                    color="bg-primary"
                />
                </div>
            </div>
        </div>
    </div>
    <Footer />
</BaseLayout>
